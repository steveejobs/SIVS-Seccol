SIVS_URL=https://sivs.exemplo.com.br
SIVS_TENDER_AGENT_SECRET=substitua-por-o-mesmo-segredo-aleatorio-de-64-caracteres-do-servidor
SIVS_TENDER_AGENT_VNC_PASSWORD=substitua-por-uma-senha-longa-e-exclusiva
SIVS_TENDER_AGENT_NOVNC_PORT=7900
SIVS_TENDER_AGENT_VIEWER_SECRET=substitua-por-segredo-aleatorio-exclusivo-de-64-caracteres
SIVS_TENDER_AGENT_VIEWER_DOMAIN=viewer.exemplo.com.br
# Mantenha 7900 apenas em localhost. A URL HTTPS do viewer protegido e configurada no SIVS:
# SIVS_TENDER_AGENT_VIEWER_URL=https://viewer.exemplo.com.br/sessao
