# Copie este arquivo para .env e preencha somente no ambiente local.
OPENROUTER_API_KEY=
OPENROUTER_TENDER_MODEL=openai/gpt-5-mini
OPENROUTER_TENDER_FALLBACK_MODEL=openai/gpt-5.4-mini
# Cadastro de parceiros (mantenha segredos apenas no ambiente de execução).
# CNPJJá Comercial: https://cnpja.com/api
CNPJA_API_KEY=
# Eventos técnicos resolvidos são mantidos por 180 dias por padrão (mínimo 30).
SIVS_TELEMETRY_RETENTION_DAYS=180
# Cofre do certificado A1: Base64 de 32 bytes. Gere uma chave exclusiva no ambiente.
SIVS_FISCAL_MASTER_KEY=
# Produção SEFAZ permanece bloqueada por padrão; habilite somente após homologação formal.
SIVS_ALLOW_SEFAZ_PRODUCTION=0
# Produção persistente cria snapshots íntegros antes de cada inicialização (2 a 30; padrão 7).
SIVS_PRESTART_BACKUP_RETENTION=7
# Recuperação de senha por e-mail. Use o domínio público sem barra final.
SIVS_PUBLIC_URL=https://oziresmoreira.online
# Hostinger Email: smtp.hostinger.com / 587 / STARTTLS.
# Alternativa: porta 465 com SIVS_SMTP_SSL=1 e SIVS_SMTP_STARTTLS=0.
SIVS_SMTP_HOST=smtp.hostinger.com
SIVS_SMTP_PORT=587
SIVS_SMTP_USERNAME=sac@oziresmoreira.online
SIVS_SMTP_PASSWORD=
SIVS_SMTP_FROM=sac@oziresmoreira.online
SIVS_SMTP_STARTTLS=1
SIVS_SMTP_SSL=0
# Formulário público do site -> CRM. Use o mesmo segredo na Vercel do lp-seccol.
SIVS_WEBSITE_LEADS_COMPANY_ID=
SIVS_WEBSITE_LEADS_SECRET=
# WhatsApp via uazapi. Nunca use no runtime um token publicado em chat, log ou commit.
# Gere SIVS_WHATSAPP_MASTER_KEY com 32 bytes aleatórios em Base64; ela cifra o token
# individual de cada empresa no SQLite. SIVS_PUBLIC_URL precisa ser HTTPS e público.
SIVS_UAZAPI_API_TOKEN=
SIVS_UAZAPI_CREATE_URL=https://grlwciflaotripbumhve.supabase.co/functions/v1/create-instance-url
SIVS_UAZAPI_CREATE_HOSTS=grlwciflaotripbumhve.supabase.co
SIVS_UAZAPI_DEVICE_NAME=SIVS SECCOL
SIVS_WHATSAPP_MASTER_KEY=
# Integração Meta legada, mantida somente para instalações já homologadas.
SIVS_WHATSAPP_COMPANY_ID=
SIVS_WHATSAPP_PHONE_NUMBER_ID=
SIVS_WHATSAPP_DISPLAY_PHONE=
SIVS_WHATSAPP_ACCESS_TOKEN=
SIVS_WHATSAPP_APP_SECRET=
SIVS_WHATSAPP_VERIFY_TOKEN=
SIVS_WHATSAPP_GRAPH_VERSION=
# Worker de navegador do agente de portal. Segredo aleatorio com 32+ caracteres.
SIVS_TENDER_AGENT_COMPANY_ID=
SIVS_TENDER_AGENT_SECRET=
# Caminho usado apenas no host do worker; mantenha um perfil Chrome corporativo dedicado.
SIVS_TENDER_AGENT_PROFILE_DIR=
# Mantenha 0 no shadow/supervisionado. Use 1 somente apos homologacao formal por portal.
SIVS_ALLOW_TENDER_AGENT_PRODUCTION=0
# Use 1 somente no primeiro bootstrap de um volume comprovadamente novo e remova em seguida.
# SIVS_ALLOW_EMPTY_DB_INITIALIZATION=1
