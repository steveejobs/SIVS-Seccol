# Copie este arquivo para .env e preencha somente no ambiente local.
OPENROUTER_API_KEY=
# Cadastro de parceiros (mantenha segredos apenas no ambiente de execução).
# CNPJJá Comercial: https://cnpja.com/api
CNPJA_API_KEY=
# Eventos técnicos resolvidos são mantidos por 180 dias por padrão (mínimo 30).
SIVS_TELEMETRY_RETENTION_DAYS=180
# Cofre do certificado A1: Base64 de 32 bytes. Gere uma chave exclusiva no ambiente.
SIVS_FISCAL_MASTER_KEY=
# Produção SEFAZ permanece bloqueada por padrão; habilite somente após homologação formal.
SIVS_ALLOW_SEFAZ_PRODUCTION=0
# Produção persistente cria snapshots íntegros antes de cada inicialização (2 a 30; padrão 7).
SIVS_PRESTART_BACKUP_RETENTION=7
# Use 1 somente no primeiro bootstrap de um volume comprovadamente novo e remova em seguida.
# SIVS_ALLOW_EMPTY_DB_INITIALIZATION=1
